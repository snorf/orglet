{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "paths": {
      "@orglet/*": ["./packages/*/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.test.ts", "packages/*/test/**/*.ts", "vitest.config.ts", "eslint.config.js"]
}
